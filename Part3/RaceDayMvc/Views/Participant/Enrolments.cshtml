@model List<EnrolmentItem>
@{
    ViewData["Title"] = "My enrolments";
}

<div class="container py-4">
    <h1 class="rd-title">My enrolments</h1>

    @if (Model.Count == 0)
    {
        <div class="rd-notice">
            <div class="rd-notice-icon">👟</div>
            <h2>You haven't entered anything yet</h2>
            <p class="text-muted">Pick an event, choose a category and you're on the start list.</p>
            <a class="btn rd-btn" asp-controller="Home" asp-action="Index">Browse events</a>
        </div>
    }
    else
    {
        <div class="card rd-card">
            <div class="table-responsive">
                <table class="table rd-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Entered on</th>
                            <th>Status</th>
                            <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a class="text-decoration-none" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a>
                                </td>
                                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@e.CategoryName</td>
                                <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                                <td><partial name="_StatusBadge" model="e.Status" /></td>
                                <td>
                                    @if (e.ResultCaptured)
                                    {
                                        <a class="text-decoration-none fw-semibold" asp-action="Results">View result</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not yet</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>