@model EventFormViewModel
@{
    var editing = Model.EventId != null;
    ViewData["Title"] = editing ? "Edit event" : "New event";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card rd-card p-4">
                <h2 class="rd-title">@(editing ? "Edit event" : "Create an event")</h2>

                <form asp-action="@(editing ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="BannerUrl" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" maxlength="150" required />
                        <span asp-validation-for="Name" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
                        <span asp-validation-for="Description" class="field-validation-error"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" type="date" class="form-control" required />
                            <span asp-validation-for="EventDate" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventType" class="form-label"></label>
                            <select asp-for="EventType" class="form-select">
                                <option value="Run">Run</option>
                                <option value="Walk">Walk</option>
                                <option value="Cycle">Cycle</option>
                            </select>
                            <span asp-validation-for="EventType" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" maxlength="150" placeholder="Town, province" required />
                            <span asp-validation-for="Location" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Distance" class="form-label"></label>
                            <input asp-for="Distance" type="number" step="0.01" min="0.01" max="9999" class="form-control" required />
                            <span asp-validation-for="Distance" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="BannerFile" class="form-label"></label>
                        @if (!string.IsNullOrEmpty(Model.BannerUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.BannerUrl" alt="Current banner" class="rounded" style="max-height:140px" />
                                <div class="form-text">Choosing a new image replaces this one.</div>
                            </div>
                        }
                        <input asp-for="BannerFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                        <div class="form-text">Optional. JPG, PNG or WEBP, up to 5 MB.</div>
                        <span asp-validation-for="BannerFile" class="field-validation-error"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn rd-btn">@(editing ? "Save changes" : "Create event")</button>
                        <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>