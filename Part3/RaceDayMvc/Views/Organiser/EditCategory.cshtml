@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card rd-card p-4">
                <h2 class="rd-title">Edit category</h2>

                <form asp-action="EditCategory" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="EventId" />

                    <partial name="_CategoryFields" model="Model" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn rd-btn">Save changes</button>
                        <a class="btn btn-outline-secondary" asp-action="Categories" asp-route-eventId="@Model.EventId">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>