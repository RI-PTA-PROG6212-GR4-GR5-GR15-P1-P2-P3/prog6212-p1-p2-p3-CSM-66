@model CategoryFormViewModel

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" maxlength="100" placeholder="e.g. 10km or Under 20" required />
    <span asp-validation-for="Name" class="field-validation-error"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Distance" class="form-label"></label>
        <input asp-for="Distance" type="number" step="0.01" min="0.01" max="9999" class="form-control" required />
        <span asp-validation-for="Distance" class="field-validation-error"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" step="0.01" min="0" max="100000" class="form-control" required />
        <span asp-validation-for="Price" class="field-validation-error"></span>
    </div>
</div>